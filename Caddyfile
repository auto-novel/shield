{
	acme_dns cloudflare {$CLOUDFLARE_API_TOKEN}
}

(maintenance) {
	@maintenance_image {
		path /maintenance-girl.webp
		file {
			root /srv/maintenance
			try_files /{args[0]}.html
		}
	}

	handle @maintenance_image {
		root * /srv/maintenance
		rewrite * /girl.webp
		file_server
	}

	@maintenance file {
		root /srv/maintenance
		try_files /{args[0]}.html
	}

	handle @maintenance {
		root * /srv/maintenance
		rewrite * /{args[0]}.html
		header Cache-Control "no-store"
		header X-Robots-Tag "noindex"
		file_server {
			status 503
		}
	}
}

monitor.novelia.cc {
	reverse_proxy core:3000
}

auth.novelia.cc {
	import maintenance auth

	handle {
		reverse_proxy core:4000
	}
}

forum.novelia.cc {
	import maintenance forum

	handle {
		reverse_proxy core:5000
	}
}

n.novelia.cc {
	import maintenance n

	handle {
		reverse_proxy core:80
	}
}

